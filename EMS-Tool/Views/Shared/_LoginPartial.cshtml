@using Microsoft.AspNetCore.Identity
@using EMS_Tool.Areas.Identity.Data;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item me-2">
        <a id="manage" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"
           class="btn btn-light w-75" style="margin-right:5px;">
            <i class="bi bi-person-fill-gear"></i> Profiel
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              class="d-inline">
            <button id="logout" type="submit" class="btn btn-light w-75" style="margin-right:5px;">
                <i class="bi bi-power"></i> Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item me-2">
        <a class="btn btn-outline-light" id="register" asp-area="Identity" asp-page="/Account/Register">
            Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-outline-success" id="login" asp-area="Identity" asp-page="/Account/Login">
            Login
        </a>
    </li>
}

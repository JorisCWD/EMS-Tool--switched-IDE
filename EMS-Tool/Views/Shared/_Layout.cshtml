@using Microsoft.AspNetCore.Identity
@using EMS_Tool.Areas.Identity.Data;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMS-Tool</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.png" sizes="32x32">

    <script type="importmap"></script>

    <!--<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> -->
    <link rel="stylesheet" href="~/css/semantic.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/class.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/text.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/EMS_Tool.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    @section Scripts {
        <script src="~/js/site.js"></script>
    }
</head>
<body>
    <div class="custom-page-wrapper">
        <header class="layout-topbar">
            <a href="@Url.Action("Index", "Home")" title="Home">
                <img alt="logo" src="@Url.Content("~/Images/logo.png")" width="300">
            </a>
            <div class="custom-dropdown">
                <button class="custom-dropdown-button"><i class="bi bi-person"></i>@UserManager.GetUserName(User)</button>
                <div class="custom-dropdown-content">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </header>
        <nav class="custom-navbar">
            @await Html.PartialAsync("_NavigationBar") <!-- Render the navigation bar -->
        </nav>
        <main class="custom-content-wrapper">
            <div class="custom-content-container">
                @RenderSection("Scripts", required: false)
                @RenderBody()
            </div>
        </main>
        <footer class="custom-footer">
            &copy; 2025 - EMS_Tool - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>
</body>
</html>

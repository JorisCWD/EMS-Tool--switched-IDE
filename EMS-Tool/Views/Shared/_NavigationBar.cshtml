<div class="custom-navigation">
    <ul>
        <li>
            <a asp-controller="Home" asp-action="Index" class="@(IsActive("Home", "Index"))">Home</a>
        </li>
        <li>
            <a asp-controller="Chart" asp-action="Index" class="@(IsActive("Chart", "Index"))">Chart</a>
        </li>
        <li>
            <a asp-controller="Home" asp-action="Privacy" class="@(IsActive("Home", "Privacy"))">Privacy</a>
        </li>
        @if (User.IsInRole("Admin"))
        {
            <li>
                <a asp-controller="Admin" asp-action="Index" class="@(IsActive("Admin", "Index"))">Admin</a>
            </li>
        }
        <partial name="_LoginPartial" />
    </ul>
</div>
@functions {
    public string IsActive(string controller, string action)
    {
        return (ViewContext.RouteData.Values["controller"].ToString() == controller &&
                 ViewContext.RouteData.Values["action"].ToString() == action)
             ? "active" : "";  // Return either 'active' or empty string
    }
}
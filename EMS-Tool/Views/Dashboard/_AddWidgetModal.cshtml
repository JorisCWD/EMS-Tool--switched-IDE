<div class="modal fade" id="addWidgetModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddChart" asp-controller="Dashboard" method="post">
            <input type="hidden" name="NavID" value="@ViewBag.Navbar.ID" />
            <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
            <div class="modal-content">
                <div class="modal-header"><h5>Add Widget</h5></div>
                <div class="modal-body">
                    <input name="ChartTitle" class="form-control mb-2" placeholder="Chart Title" required />

                    <!-- Table dropdown -->
                    <select id="tableSelect" class="form-control mb-2">
                        <option value="">Select Table</option>
                        @foreach (var table in (List<string>)ViewBag.Tables)
                        {
                            <option value="@table">@table</option>
                        }
                    </select>

                    <!-- Column dropdowns for x/y axis -->
                    <select id="xColumnSelect" name="XColumn" class="form-control mb-2">
                        <option value="">Select X Column</option>
                    </select>
                    <select id="yColumnSelect" name="YColumn" class="form-control mb-2">
                        <option value="">Select Y Column</option>
                    </select>

                    <select name="ChartType" class="form-control">
                        <option value="Bar">Bar</option>
                        <option value="Line">Line</option>
                        <option value="Pie">Pie</option>
                    </select>

                    <input type="hidden" name="DataQuery" id="dataQueryInput" />
                </div>
                <div class="chart-container">
                    <h6>Preview:</h6>
                    <canvas id="chartPreview" width="400" height="200"></canvas>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </div>
        </form>
    </div>
</div>
@using EMS_Tool.Model
@model IEnumerable<Chart>

@{
    var selectedNav = ViewBag.Navbar as Navbar ?? new Navbar { Name = "Default Navbar" };
    var navItems = ViewBag.NavbarItems as List<Navbar> ?? new List<Navbar>();
    int selectedNavId = ViewBag.NavID ?? 0;
}
@section Scripts {
    <link href="~/lib/gridstack/gridstack.min.css" rel="stylesheet" />
    <script src="~/lib/gridstack/gridstack-all.js"></script>
    <script src="~/lib/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <script src="~/js/chartConfig.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script src="~/lib/chartjs-plugin-zoom/chartjs-plugin-zoom.min.js"></script>
    <script>
        window.projectId = @ViewBag.ProjectID;
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    </script>
}

<head>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Optional: Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>

<nav class="dash-navigation">
    <ul>
        @foreach (var nav in navItems)
        {
            <li>
                <a href="@Url.Action("Dashboard", new { projectId = ViewBag.ProjectId, navId = nav.ID })"
                   class="@(nav.ID == selectedNavId ? "active" : "")">
                    @nav.Name
                </a> <!-- i want a delete button somewhere around here, nestled inside the link a element-->
            </li>
        }
        <li>
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addNavbarModal"
                    data-bs-toggle="tooltip" data-bs-placement="top" title="Add Navbar Item">
                <i class="bi bi-plus-circle"></i>
            </button>
        </li>
    </ul>
</nav>

<div class="side-by-side">
    <h2 class="compact">@selectedNav.Name</h2>
    
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWidgetModal">Add Widget</button>
</div>
<div id="dashboard-container" class="mt-4 position-relative w-100 p-0">
    <div class="grid-stack" id="dashboard">
        @foreach (var chart in Model)
        {
            <div class="grid-stack-item"
                    gs-x="@chart.PositionX"
                    gs-y="@chart.PositionY"
                    gs-w="@Math.Max(1, chart.Width / 100)"
                    gs-h="@Math.Max(1, chart.Height / 100)"
                    data-id="@chart.ID">

                <div class="grid-stack-item-content border">
                    <!--<h5>//chart.ChartTitle</h5>-->
                    <canvas id="chart-@chart.ID"
                            data-type="@chart.ChartType"
                            data-title="@chart.ChartTitle">
                    </canvas>
                    <div class="chart-buttons">
                        <button class="btn btn-sm btn-danger delete-chart" data-id="@chart.ID">Delete</button>
                        <button class="btn btn-sm btn-warning edit-btn"
                                data-id="@chart.ID"
                                data-title="@chart.ChartTitle"
                                data-charttype="@chart.ChartType"
                                data-query="@chart.DataQuery"
                                data-bs-toggle="modal"
                                data-bs-target="#editChartModal">
                            Edit
                        </button>
                        <button class="btn btn-sm btn-info export-chart" data-id="@chart.ID">Export CSV</button>
                        <button class="btn btn-sm btn-info export-chart" id="resetZoomBtn">Reset Zoom</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- Bootstrap Bundle JS (includes Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@await Html.PartialAsync("_AddNavbarModal")
@await Html.PartialAsync("_AddWidgetModal")
@await Html.PartialAsync("_EditChartModal")


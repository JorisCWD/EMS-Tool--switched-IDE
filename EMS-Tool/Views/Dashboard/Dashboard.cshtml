@using EMS_Tool.Model
@model IEnumerable<Chart>

@{
    var selectedNav = ViewBag.Navbar as Navbar ?? new Navbar { Name = "Default Navbar" };
    var navItems = ViewBag.NavbarItems as List<Navbar> ?? new List<Navbar>();
    int selectedNavId = ViewBag.NavID ?? 0;
}
@section Scripts {
    <link href="~/lib/gridstack/dist/gridstack.min.css" rel="stylesheet" />
    <script src="~/lib/gridstack/dist/gridstack-all.js"></script>

    <link href="~/lib/hammer.js/hammer.js" rel="stylesheet"/>

    <script src="~/lib/chart.js/dist/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <script src="~/lib/chartjs-plugin-zoom/dist/chartjs-plugin-zoom.min.js"></script>

    <script>
        Chart.register(window['chartjs-plugin-zoom']); // ✅ Register plugin here
    </script>

    <script src="~/js/chartConfig.js"></script>
    <script src="~/js/dashboard.js"></script>

    <script>
        window.projectId = parseInt('@ViewBag.ProjectID');
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
        console.log("window.projectId from Razor:", '@ViewBag.ProjectId');
    </script>
}

<head>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Optional: Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>

<header class="custom-page-header d-flex justify-content-between align-items-center pb-2">
    <h2 class="compact m-0">@selectedNav.Name</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWidgetModal">Add Graph</button>
</header>


<div id="dashboard-container" class="mt-0 position-relative w-100 p-0">
    <div class="grid-stack" id="dashboard">
        @foreach (var chart in Model)
        {
            <div class="grid-stack-item d-flex"
                 gs-x="@chart.PositionX"
                 gs-y="@chart.PositionY"
                 gs-w="@Math.Max(1, chart.Width / 100)"
                 gs-h="@Math.Max(1, chart.Height / 100)"
                 data-id="@chart.ID">

                <div class="grid-stack-item-content border me-1 d-flex">
                    <!-- Header with title + dropdown -->
                    <div class="d-flex justify-content-between align-items-right px-2 pt-2">

                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button class="dropdown-item text-secondary toggle-lock-btn" data-id="@chart.ID">
                                        <i class="bi bi-unlock"></i> Lock Widget
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item text-danger delete-chart" data-id="@chart.ID">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-warning edit-btn"
                                            data-id="@chart.ID"
                                            data-title="@chart.ChartTitle"
                                            data-charttype="@chart.ChartType"
                                            data-query="@chart.DataQuery"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editChartModal">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-info export-chart" data-id="@chart.ID">
                                        <i class="bi bi-download"></i> Export CSV
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-info reset-zoom-btn" data-id="@chart.ID">
                                        <i class="bi bi-arrow-counterclockwise"></i> Reset Zoom
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Chart -->
                    <canvas class="me-1" id="chart-@chart.ID"
                            data-type="@chart.ChartType"
                            data-title="@chart.ChartTitle">
                    </canvas>
                </div>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_AddNavbarModal")
@await Html.PartialAsync("_AddWidgetModal")
@await Html.PartialAsync("_EditChartModal")


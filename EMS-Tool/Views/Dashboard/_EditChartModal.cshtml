<div class="modal fade" id="editChartModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="editChartForm" asp-action="EditChart" asp-controller="Dashboard" method="post">
            <input type="hidden" name="ID" id="editChartId" />
            <input type="hidden" name="NavID" value="@ViewBag.Navbar.ID" />
            <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />

            <div class="modal-content">
                <div class="modal-header"><h5>Edit Chart</h5></div>
                <div class="modal-body">
                    <input name="ChartTitle" id="editChartTitle" class="form-control mb-2" placeholder="Chart Title" required />

                    <select id="editTableSelect" class="form-control mb-2">
                        <option value="">Select Table</option>
                        @foreach (var table in (List<string>)ViewBag.Tables)
                        {
                            <option value="@table">@table</option>
                        }
                    </select>

                    <select id="editXColumnSelect" name="XColumn" class="form-control mb-2">
                        <option value="">Select X Column</option>
                    </select>

                    <select id="editYColumnSelect" name="YColumn" class="form-control mb-2">
                        <option value="">Select Y Column</option>
                    </select>

                    <select name="ChartType" id="editChartType" class="form-control">
                        <option value="Bar">Bar</option>
                        <option value="Line">Line</option>
                        <option value="Pie">Pie</option>
                    </select>

                    <input type="hidden" name="DataQuery" id="editDataQueryInput" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </form>
    </div>
</div>


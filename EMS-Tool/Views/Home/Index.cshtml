@model EMS_Tool.Model.UserProjectViewModel
@{
    ViewData["Title"] = "Home Page";
}

<header class="page-header"><h2>Welcome, @Model.Email</h2></header>

@if (Model.AssignedProjects.Any())
{
    @foreach (var project in Model.AssignedProjects)
    {
    <div class="building-tile"><a asp-controller="Home" asp-action="Privacy">
         <div class="building-img"> block </div>
         <div class="project-number"> @project.ProjectNumber </div>
    </a></div>
    }
}
else
{
    <p>No projects assigned to you.</p>
}

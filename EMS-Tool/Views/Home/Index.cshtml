@model EMS_Tool.Model.UserProjectViewModel
@{
	Layout = "_Layout";
}

<header class="custom-page-header">
    <h2>Gebouwen</h2>
</header>

@if (Model.AssignedProjects.Any())
{
    @foreach (var project in Model.AssignedProjects)
    {
        <div class="building-tile">
            <a href="@Url.Action("Dashboard", "Dashboard", new { projectId = project.Id, navId = 1})">
                <div class="building-img"></div>
                <div class="project-number">@project.ProjectNumber</div>
            </a>
        </div>
    }
}
else
{
    <p style="color:black;font-size:15px;">No projects assigned to you.</p>
}
